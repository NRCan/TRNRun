* text=auto

*.f90 text eol=lf
*.py text eol=lf
*.nim text eol=lf
*.md text eol=lf
*.m text eol=lf
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.bat text eol=crlf
*.dck text eol=crlf
*.tmf text eol=crlf

*.exe binary
*.dll binary
*.mlx binary

# Prevent GitHub from displaying comments within JSON files as errors.
*.json linguist-language=JSON-with-Comments
