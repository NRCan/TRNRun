{
    "_schemaVersion": "1.0.0",

    "trnrun.SimulationSettings":
    {
        "inputs":
        [
            {"name":"trnexePath", "kind":"namevalue", "type":["file=*.exe"], "purpose":"TRNSYS executable"},
            {"name":"guiVisibility", "kind":"namevalue", "type":["choices={'keep','auto','min','minAuto','hidden'}"], "purpose":"TRNSYS window mode"},
            {"name":"waitForGui", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Wait for a TRNSYS window"},
            {"name":"waitForLst", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Wait for the .lst component header"},
            {"name":"waitForTmp", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Wait for a Type3830 .tmp file"},
            {"name":"detectTimeout", "kind":"namevalue", "type":["numeric","scalar","integer",">=0"], "purpose":"Launch-detection deadline (ms)"},
            {"name":"extraDelay", "kind":"namevalue", "type":["numeric","scalar","integer",">=0"], "purpose":"Delay after launch detection (ms)"},
            {"name":"pollMs", "kind":"namevalue", "type":["numeric","scalar","integer",">=1"], "purpose":"Runner polling interval (ms)"},
            {"name":"watchLog", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Report TRNSYS .log entries"},
            {"name":"watchTmp", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Report Type3830 progress"},
            {"name":"watchTimeout", "kind":"namevalue", "type":["numeric","scalar","integer",">=0"], "purpose":"Runtime limit (ms); 0 disables"},
            {"name":"stallTimeout", "kind":"namevalue", "type":["numeric","scalar","integer",">=0"], "purpose":"Longest time without progress (ms); 0 disables"},
            {"name":"clean", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Delete TRNSYS outputs after success"},
            {"name":"killOnTimeout", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Kill TRNSYS after a timeout"},
            {"name":"killOnStall", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Kill TRNSYS after a stall"},
            {"name":"severity", "kind":"namevalue", "type":["choices={'Notice','Warning','Fatal'}"], "purpose":"Minimum log severity"},
            {"name":"writeEvents", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Write the events to a .jsonl file beside the deck"}
        ],
        "outputs":
        [
            {"name":"obj", "type":["trnrun.SimulationSettings"]}
        ]
    },

    "trnrun.SimulationManager":
    {
        "inputs":
        [
            {"name":"workers", "kind":"namevalue", "type":["numeric","scalar","integer",">=1"], "purpose":"Simulations run at once"},
            {"name":"refreshInterval", "kind":"namevalue", "type":["numeric","scalar","real"], "purpose":"Seconds between progress redraws; <=0 disables output"},
            {"name":"pollInterval", "kind":"namevalue", "type":["numeric","scalar",">=0"], "purpose":"Seconds between refreshes while blocking"},
            {"name":"trnrundPath", "kind":"namevalue", "type":["file=*.exe"], "purpose":"trnrund executable"},
            {"name":"trnrunPath", "kind":"namevalue", "type":["file=*.exe"], "purpose":"TRNRun executable"}
        ],
        "outputs":
        [
            {"name":"obj", "type":["trnrun.SimulationManager"]}
        ]
    },

    "trnrun.SimulationManager.add":
    {
        "inputs":
        [
            {"name":"obj", "kind":"required", "type":["trnrun.SimulationManager"]},
            {"name":"deckFile", "kind":"required", "type":["file=*.dck,*.trd"], "purpose":"Deck to run"},
            {"name":"settings", "kind":"ordered", "type":["trnrun.SimulationSettings"], "purpose":"TRNRun options"},
            {"name":"label", "kind":"namevalue", "type":["char","string"], "purpose":"Free text shown instead of the deck path"},
            {"name":"waitFor", "kind":"namevalue", "type":["choices={'QUEUED','RUNNING','FINISHED'}"], "purpose":"Least state to block for"}
        ],
        "outputs":
        [
            {"name":"simulation", "type":["trnrun.Simulation"]}
        ]
    },

    "trnrun.SimulationManager.wait":
    {
        "inputs":
        [
            {"name":"obj", "kind":"required", "type":["trnrun.SimulationManager"]},
            {"name":"simulations", "kind":"ordered", "type":["trnrun.Simulation"], "purpose":"Simulations to wait for; every one by default"},
            {"name":"until", "kind":"namevalue", "type":["choices={'QUEUED','RUNNING','FINISHED'}"], "purpose":"Least state each must reach"},
            {"name":"timeout", "kind":"namevalue", "type":["numeric","scalar",">=0"], "purpose":"Seconds to wait at most"}
        ]
    },

    "trnrun.SimulationManager.cancel":
    {
        "inputs":
        [
            {"name":"obj", "kind":"required", "type":["trnrun.SimulationManager"]},
            {"name":"simulations", "kind":"required", "type":["trnrun.Simulation"], "purpose":"Simulations to stop"}
        ]
    },

    "trnrun.SimulationManager.refresh":
    {
        "inputs":
        [
            {"name":"obj", "kind":"required", "type":["trnrun.SimulationManager"]}
        ]
    },

    "trnrun.Daemon":
    {
        "inputs":
        [
            {"name":"workers", "kind":"namevalue", "type":["numeric","scalar","integer",">=1"], "purpose":"Simulations run at once"},
            {"name":"trnrundPath", "kind":"namevalue", "type":["file=*.exe"], "purpose":"trnrund executable"},
            {"name":"trnrunPath", "kind":"namevalue", "type":["file=*.exe"], "purpose":"TRNRun executable"}
        ],
        "outputs":
        [
            {"name":"obj", "type":["trnrun.Daemon"]}
        ]
    },

    "trnrun.Daemon.add":
    {
        "inputs":
        [
            {"name":"obj", "kind":"required", "type":["trnrun.Daemon"]},
            {"name":"deckFile", "kind":"required", "type":["file=*.dck,*.trd"], "purpose":"Deck to run"},
            {"name":"settings", "kind":"ordered", "type":["trnrun.SimulationSettings"], "purpose":"TRNRun options"},
            {"name":"label", "kind":"namevalue", "type":["char","string"], "purpose":"Free text stored with the simulation"}
        ],
        "outputs":
        [
            {"name":"simId", "type":["numeric","scalar"]}
        ]
    },

    "trnrun.Daemon.simulations":
    {
        "inputs":
        [
            {"name":"obj", "kind":"required", "type":["trnrun.Daemon"]},
            {"name":"state", "kind":"required", "type":["choices={'QUEUED','RUNNING','FINISHED'}"], "purpose":"States to return"},
            {"name":"withLogs", "kind":"namevalue", "type":["logical","scalar"], "purpose":"Include log entries"}
        ],
        "outputs":
        [
            {"name":"simulations", "type":["trnrun.Simulation"]}
        ]
    },

    "trnrun.version":
    {
        "outputs":
        [
            {"name":"value", "type":["char"]}
        ]
    }
}
