<Window x:Class="TRNRun.GuiExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRNRun" Width="1240" Height="800" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <SolidColorBrush x:Key="QueuedBrush" Color="#7A7574" />
    <SolidColorBrush x:Key="RunningBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="SucceededBrush" Color="#107C10" />
    <SolidColorBrush x:Key="FailedBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CancelledBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="FatalTextBrush" Color="#D13438" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#CA5010" />

    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Table" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Extended" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="1" />
    </Style>

    <!-- Run cells, centered beside the status badges. -->
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Log cells, colored by severity. -->
    <Style x:Key="LogText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Fatal">
          <Setter Property="Foreground" Value="{StaticResource FatalTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="24,16,24,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="TRNRun" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource SecondaryText}"
                 Text="Run TRNSYS decks side by side and follow them live. Drop .dck files or folders anywhere on this window." />
    </StackPanel>

    <!-- Settings: the database and concurrency are fixed once trnrund starts with the first deck. -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource LabelText}" Text="TRNSYS executable" />
        <TextBox x:Name="TrnexeBox" Grid.Column="1"
                 ToolTip="TrnEXE64.exe used by the decks you add next." />
        <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseTrnexe" />

        <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="Database" Margin="0,8,16,0" />
        <TextBox x:Name="DatabaseBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                 ToolTip="Keeps every run and log between sessions. Leave empty for a temporary database deleted on exit." />
        <Button x:Name="BrowseDatabaseButton" Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,8,0,0"
                Click="OnBrowseDatabase" />

        <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="Simulations at once" Margin="0,12,16,0" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
          <ComboBox x:Name="MaxConcurrentBox" MinWidth="80" />
          <CheckBox x:Name="TrackProgressBox" Content="Track progress (needs Type3830 in the deck)" IsChecked="True"
                    Margin="32,0,0,0" VerticalAlignment="Center" />
          <CheckBox x:Name="ShowTrnsysBox" Content="Show TRNSYS windows" Margin="32,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toolbar -->
    <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
      <Button x:Name="AddDecksButton" Content="Add decks…" Style="{DynamicResource AccentButtonStyle}" Click="OnAddDecks" />
      <Button x:Name="AddFolderButton" Content="Add folder…" Margin="8,0,0,0" Click="OnAddFolder" />
      <Button Content="Cancel selected" Margin="24,0,0,0" Click="OnCancelSelected" />
      <Button Content="Cancel all" Margin="8,0,0,0" Click="OnCancelAll" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="OverallText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ProgressBar x:Name="OverallProgress" Width="220" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" MinHeight="140" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="100" />
      </Grid.RowDefinitions>

      <!-- Runs -->
      <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
          <DataGrid x:Name="RunsGrid" Style="{StaticResource Table}" ItemsSource="{Binding Runs}"
                    SelectionChanged="OnRunSelectionChanged" MouseDoubleClick="OnRunDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding RunId}" Width="50" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Deck" Binding="{Binding Label}" Width="2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                    <Setter Property="ToolTip" Value="{Binding DeckFile}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="StatusText">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource QueuedBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Running">
                              <Setter Property="Background" Value="{StaticResource RunningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Succeeded">
                              <Setter Property="Background" Value="{StaticResource SucceededBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Failed">
                              <Setter Property="Background" Value="{StaticResource FailedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Cancelled">
                              <Setter Property="Background" Value="{StaticResource CancelledBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Progress" Width="190" SortMemberPath="Percent">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <ProgressBar Maximum="100" VerticalAlignment="Center"
                                   Value="{Binding Percent, Mode=OneWay}"
                                   IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                      <TextBlock Grid.Column="1" Text="{Binding PercentText}" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Simulated" Binding="{Binding SimTimeText}" Width="130" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedText}" Width="80" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Remaining" Binding="{Binding EtaText}" Width="95" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" Width="85" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Fatals" Binding="{Binding Fatals}" Width="65" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Shown until the first run appears. -->
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     FontSize="16" IsHitTestVisible="False"
                     Text="Drop .dck files or folders here, or use Add decks…">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Runs.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" Background="Transparent"
                    ResizeDirection="Rows" />

      <!-- Logs of the selected runs, or of every run -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,10,16,4">
            <CheckBox x:Name="ShowNoticesBox" DockPanel.Dock="Right" Content="Show notices"
                      Checked="OnLogFilterChanged" Unchecked="OnLogFilterChanged" />
            <TextBlock x:Name="LogTitle" Text="Log · all runs" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid x:Name="LogsGrid" Style="{StaticResource Table}" ItemsSource="{Binding Logs}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Run" Binding="{Binding Run}" Width="160" ElementStyle="{StaticResource LogText}" />
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85" ElementStyle="{StaticResource LogText}" />
              <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:N2} h}" Width="95"
                                  ElementStyle="{StaticResource LogText}" />
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140" ElementStyle="{StaticResource LogText}" />
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource LogText}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextTrimming" Value="None" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="4" Margin="2,10,2,0">
      <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="16,0,0,0" />
      <TextBlock x:Name="SessionText" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                 Text="trnrund starts with the first deck you add." />
    </DockPanel>
  </Grid>
</Window>
