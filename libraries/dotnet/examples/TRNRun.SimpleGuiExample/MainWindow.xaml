<Window x:Class="TRNRun.SimpleGuiExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRNRun" Width="1000" Height="600"
        Loaded="OnLoaded" Closing="OnClosing">
  <DockPanel Margin="8">
    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8"
            Content="Add decks…" Click="OnAddDecks" />

    <!-- Logs of the run whose Logs button was clicked, all columns generated from LogEvent. -->
    <DockPanel DockPanel.Dock="Bottom" Height="200" Margin="0,8,0,0">
      <TextBlock x:Name="LogsTitle" DockPanel.Dock="Top" Margin="0,0,0,4" Text="Click a run's Logs button to see its logs." />
      <DataGrid x:Name="LogsGrid" IsReadOnly="True" />
    </DockPanel>

    <!-- Each row is the latest Simulation trnrund reported for that run. -->
    <DataGrid ItemsSource="{Binding Runs}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding SimId}" />
        <DataGridTextColumn Header="Deck" Binding="{Binding Label}" Width="2*" />
        <DataGridTextColumn Header="State" Binding="{Binding State}" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
        <DataGridTextColumn Header="Progress" Binding="{Binding Percent, StringFormat=P0}" />
        <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" />
        <DataGridTextColumn Header="Fatals" Binding="{Binding Fatals}" />
        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="3*" />
        <DataGridTemplateColumn>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="Logs" Click="OnShowLogs" />
                <Button Content="Cancel" Click="OnCancel" Margin="4,0,0,0" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
