<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Trim and AOT analyzers; with warnings as errors, a change that breaks them fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- A .snupkg beside the .nupkg, so debuggers step into the source via Source Link. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>TRNRun</PackageId>
    <Version>0.8.0</Version>
    <Authors>Natural Resources Canada / Ressources naturelles Canada;CanmetENERGY in Varennes / CanmetÉNERGIE à Varennes;Alex Lachance</Authors>
    <Description>Run TRNSYS simulations through the trnrund daemon: a thin client of its JSON request protocol.</Description>
    <PackageTags>TRNSYS;simulation;Windows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/NRCan/TRNRun</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NRCan/TRNRun</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <_NativeRunnerPath>$(MSBuildThisFileDirectory)../../../../components/trnrun/build/trnrun.exe</_NativeRunnerPath>
    <_NativeDaemonPath>$(MSBuildThisFileDirectory)../../../../components/trnrund/build/trnrund.exe</_NativeDaemonPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TRNRun.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <!-- Link the real native build outputs; do not keep a second staged copy. -->
    <None Include="$(_NativeRunnerPath)" Link="native/trnrun.exe"
          Pack="true" PackagePath="native/" ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(_NativeDaemonPath)" Link="native/trnrund.exe"
          Pack="true" PackagePath="native/" ExcludeFromSingleFile="true"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../packaging/TRNRun.targets"
          Pack="true" PackagePath="buildTransitive/TRNRun.targets" />
  </ItemGroup>

  <Target Name="RequireNativeExecutables" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(_NativeRunnerPath)')"
           Text="Missing trnrun.exe. Run 'just trnrun-bin' from the repository root before building the .NET library." />
    <Error Condition="!Exists('$(_NativeDaemonPath)')"
           Text="Missing trnrund.exe. Run 'just trnrund-bin' from the repository root before building the .NET library." />
  </Target>

  <!-- GenerateNuspec is reached even when packing without a build. -->
  <Target Name="ValidateNativeExecutablesForPack" BeforeTargets="GenerateNuspec" DependsOnTargets="RequireNativeExecutables">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="Pack TRNRun on Windows so both native executables can be checked with --version." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../packaging/Validate-NativeExecutables.ps1&quot; -RunnerPath &quot;$(_NativeRunnerPath)&quot; -DaemonPath &quot;$(_NativeDaemonPath)&quot; -PackageVersion &quot;$(PackageVersion)&quot;" />
  </Target>
</Project>
