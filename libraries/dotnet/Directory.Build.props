<Project>
  <PropertyGroup>
    <!-- Plain net10.0, so default console apps can reference it; the attribute below marks it Windows-only. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Minimum runtime patch written to *.runtimeconfig.json of every app/test host (patch roll-forward still applies). -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Release builds are what get packed: keep local paths out of the published PDB. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
